{
  "name": "dsh-next-message",
  "version": "0.1.0",
  "description": "Conversation-aware next-message predictions for DeepSeek Harness. Tab accepts an editable draft.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs/VALIDATION.md",
    "README.en.md",
    "docs/assets"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "eval": "node scripts/evaluate.mjs",
    "check": "node scripts/build.mjs && node --test tests/*.test.js && node scripts/evaluate.mjs",
    "prepack": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/746445568/dsh-next-message.git"
  },
  "homepage": "https://github.com/746445568/dsh-next-message#readme",
  "bugs": {
    "url": "https://github.com/746445568/dsh-next-message/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "autocomplete",
    "next-message"
  ]
}
